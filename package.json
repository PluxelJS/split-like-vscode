{
  "name": "split-like-vscode",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run workspace:build",
    "dev": "pitchfork start demo",
    "source-declarations:check": "node scripts/check-source-declarations.mjs",
    "test": "vp run workspace:test",
    "typecheck": "vp run workspace:types",
    "catalog:add": "pncat add",
    "catalog:detect": "pncat detect --yes",
    "catalog:migrate": "pncat migrate --yes",
    "catalog:clean": "pncat clean --yes",
    "test:browser": "vp run check-browser",
    "test:package": "vp run check-package-consumer",
    "measure": "node scripts/measure-workbench.mjs",
    "measure:native": "node scripts/measure-native-layout.mjs",
    "check": "vp check",
    "fix": "vp check --fix",
    "hooks:install": "hk install --mise",
    "verify": "vp run workspace:verify"
  },
  "devDependencies": {
    "@playwright/test": "catalog:test",
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "pncat": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  },
  "packageManager": "pnpm@11.28.2"
}
