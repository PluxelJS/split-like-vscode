{
  "name": "split-like-vscode",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "postbuild": "pnpm source-declarations:check",
    "dev": "turbo run dev --filter=@worksplit/demo --ui stream",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "turbo run lint && oxlint -c oxlint.config.ts oxlint.config.ts --deny-warnings",
    "lint:fix": "oxlint -c oxlint.config.ts . --fix",
    "source-declarations:check": "node scripts/check-source-declarations.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.typecheck.json --noEmit",
    "catalog:add": "pncat add",
    "catalog:check": "pncat detect --yes",
    "catalog:migrate": "pncat migrate --yes",
    "catalog:clean": "pncat clean --yes"
  },
  "devDependencies": {
    "@tsdown/css": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "pncat": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "turbo": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:test"
  },
  "packageManager": "pnpm@11.8.0"
}
