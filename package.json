{
  "name": "split-like-vscode",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "postbuild": "pnpm source-declarations:check",
    "dev": "turbo run dev --filter=@worksplit/demo --ui stream",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "turbo run lint && oxlint -c oxlint.config.ts oxlint.config.ts --deny-warnings",
    "lint:fix": "oxlint -c oxlint.config.ts . --fix",
    "source-declarations:check": "node scripts/check-source-declarations.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.typecheck.json --noEmit"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.8.0"
}
