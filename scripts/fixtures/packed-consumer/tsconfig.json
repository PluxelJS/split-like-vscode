{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "noEmit": true,
    "types": ["react", "react-dom", "vite/client"],
    "verbatimModuleSyntax": true
  },
  "include": ["src", "types.ts"],
  "exclude": ["src/**/*.test.ts"]
}
