{
  "name": "@worksplit/split-view",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "dist/style.css",
    "src/style.css"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./style.css": "./src/style.css"
  },
