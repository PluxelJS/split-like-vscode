{
  "name": "@worksplit/core",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vp run compile",
    "test": "vp run check-tests",
    "typecheck": "vp run check-types",
    "check": "vp check",
    "fix": "vp check --fix"
  },
  "devDependencies": {
    "vite-plus": "catalog:build"
  }
}
