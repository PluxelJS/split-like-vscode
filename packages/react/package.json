{
  "name": "@worksplit/react",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "dist/style.css",
    "src/style.css"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./style.css": "./src/style.css"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./style.css": "./dist/style.css"
    }
  },
  "scripts": {
    "build": "vp run compile",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp run check-tests",
    "typecheck": "vp run check-types"
  },
  "dependencies": {
    "@worksplit/core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:test",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "jsdom": "catalog:test",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "vite-plus": "catalog:tooling"
  },
  "peerDependencies": {
    "react": ">=18.3.0 || >=19.0.0",
    "react-dom": ">=18.3.0 || >=19.0.0"
  }
}
