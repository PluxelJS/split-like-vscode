{
  "name": "@worksplit/react",
  "version": "0.1.0",
  "files": [
    "dist",
    "native-dependencies"
  ],
  "type": "module",
  "sideEffects": [
    "dist/style.css",
    "src/style.css"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./style.css": "./src/style.css",
    "./native-dependencies/install.mjs": "./native-dependencies/install.mjs"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./style.css": "./dist/style.css",
      "./native-dependencies/install.mjs": "./native-dependencies/install.mjs"
    }
  },
  "scripts": {
    "build": "vp run compile",
    "test": "vp run check-tests",
    "typecheck": "vp run check-types",
    "check": "vp check",
    "fix": "vp check --fix",
    "prepack": "node ../../scripts/native-dependency-artifact.mjs native-dependencies"
  },
  "devDependencies": {
    "@tanstack/react-hotkeys": "catalog:frontend",
    "@tanstack/react-store": "catalog:frontend",
    "@testing-library/react": "catalog:test",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "capnweb": "catalog:dev",
    "jsdom": "catalog:dev",
    "pacote": "catalog:build",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "vite": "catalog:tooling",
    "vite-plus": "catalog:build"
  },
  "peerDependencies": {
    "@tanstack/react-router": "catalog:peer",
    "@tanstack/react-store": "^0.11.2",
    "flexlayout-react": "catalog:peer",
    "react": ">=18.3.0 || >=19.0.0",
    "react-dom": ">=18.3.0 || >=19.0.0"
  }
}
