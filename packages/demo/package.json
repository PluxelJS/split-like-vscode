    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@worksplit/react": "workspace:*",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
